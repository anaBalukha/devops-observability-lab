{
  "id": null,
  "uid": "observability-lab-dashboard",
  "title": "DevOps Observability Lab - Application Metrics",
  "tags": ["devops", "observability", "prometheus", "loki"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "panels": [
    {
      "type": "stat",
      "title": "Requests in last 1 minute",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 8,
        "h": 6
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum(increase(app_requests_total[1m]))",
          "legendFormat": "requests/min",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Errors in last 1 minute",
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 8,
        "h": 6
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "increase(app_errors_total[1m])",
          "legendFormat": "errors/min",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Application requests by endpoint/status",
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum by (endpoint, status) (increase(app_requests_total[1m]))",
          "legendFormat": "{{endpoint}} - {{status}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Application errors per minute",
      "gridPos": {
        "x": 12,
        "y": 6,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "increase(app_errors_total[1m])",
          "legendFormat": "errors/min",
          "refId": "A"
        }
      ]
    }
  ]
}
